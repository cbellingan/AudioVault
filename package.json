{
  "name": "audiovault",
  "version": "1.0.0",
  "description": "Hardware Ingestion, Local-First AI Classifier, and Non-Destructive Audio Vault for Field Recorders & Creators",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "relay:build": "esbuild relay/web/app.ts --bundle --outfile=relay/web/bundle.js --format=esm && esbuild relay/server/run.ts --bundle --platform=node --format=esm --outfile=relay/dist/run.mjs --packages=external",
    "relay:start": "npm run relay:build && node relay/dist/run.mjs",
    "relay:test": "vitest run relay/crypto/crypto.test.ts && playwright test e2e/secure-relay.spec.ts"
  },
  "keywords": [
    "audiovault",
    "audio",
    "recorder",
    "zoom",
    "field-recorder",
    "transcription",
    "whisper",
    "local-ai",
    "electron",
    "react"
  ],
  "author": "Carl Bellingan",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
